{
  "name": "munka-program",
  "version": "0.2.0",
  "private": true,
  "description": "Munka Windows school and daily-life planner",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node scripts/launch.cjs",
    "test": "node --test tests/*.test.mjs",
    "pack": "node scripts/build-windows.cjs",
    "preview": "node scripts/preview.cjs",
    "prestart": "node scripts/prepare-assets.cjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "prettier": "3.9.6"
  },
  "build": {
    "appId": "app.munka.planner",
    "productName": "Munka",
    "directories": {
      "output": "outputs/release"
    },
    "files": [
      "src/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/wallpaper.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/munka.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "electronDist": "node_modules/electron/dist"
  },
  "author": "Munka"
}

