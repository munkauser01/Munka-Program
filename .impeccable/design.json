  "narrative": {
    "northStar": "A readable desk",
    "overview": "Munka brings tasks and planned time into a warm, readable desktop workspace. Sage navigation, paper surfaces, dark text, and the original hanging monkey emblem express the approved calm, helpful character with restrained playfulness.\n\nThe interface favors readable rows and contextual details. Color and softly curved surfaces separate actions and supporting content without making each task a floating card. This document records the current renderer in `src/styles.css` and `src/app.mjs`; the wallpaper renderer is a compact, separately styled companion.",
    "keyCharacteristics": [
      "Warm paper with muted sage and olive.",
      "Clear task rows and understated dividers.",
      "Rounded controls and flat supporting surfaces.",
      "Original monkey emblem with restrained personality.",
      "Visible keyboard focus and reduced-motion support."
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "Use the same semantic role for the same state in light and dark mode.",
        "section": "colors"
      },
      {
        "name": "The Readable Row Rule",
        "body": "Let task titles wrap and metadata flow onto another line rather than hiding task meaning.",
        "section": "typography"
      },
      {
        "name": "The Overlay Depth Rule",
        "body": "Keep routine rows and collection cards flat; reserve the shared shadow for content above the workspace.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the original hanging monkey emblem.",
      "Do use semantic color roles across light and dark themes.",
      "Do keep tasks readable as wrapping rows with secondary metadata.",
      "Do maintain visible keyboard focus and reduced-motion behavior.",
      "Do distinguish deadlines from planned schedule time in the interface."
    ],
    "donts": [
      "Don't turn ordinary task rows into elevated cards.",
      "Don't replace the original logo with a generic mascot.",
      "Don't treat the wallpaper's fixed light colors as dark-theme tokens.",
      "Don't infer a decorative display font or a marketing typography system from the Windows interface."
    ]
  }
}
